{
  "name": "soma-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4180",
    "test": "node --experimental-strip-types --test tests/*.test.ts && cargo test --manifest-path Cargo.toml --workspace --locked",
    "wasm:build": "wasm-pack build crates/wasm --target web --out-dir ../../src/generated/viewer --release --no-opt --locked && wasm-pack build crates/content --target web --out-dir ../../src/generated/content --release --no-opt --locked",
    "predev": "npm run wasm:build",
    "prebuild": "npm run wasm:build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
